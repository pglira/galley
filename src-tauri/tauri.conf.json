{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galley",
  "version": "0.2.0",
  "identifier": "dev.galley.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Galley",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "Philipp Glira",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "homepage": "https://pglira.github.io/galley/",
    "category": "Productivity",
    "shortDescription": "Review Markdown and PDF documents from AI agents",
    "longDescription": "Galley opens a directory of documents and snapshots from AI agents, shows the diff between snapshots, lets you annotate the text, and copies a prompt with the annotations for the agent.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "text",
        "desktopTemplate": "galley.desktop"
      },
      "rpm": {
        "release": "1",
        "desktopTemplate": "galley.desktop"
      }
    }
  }
}
